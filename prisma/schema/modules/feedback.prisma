model Feedback {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  comment   String    @db.Text
  status    String    @default("pending")
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([createdAt])
}
