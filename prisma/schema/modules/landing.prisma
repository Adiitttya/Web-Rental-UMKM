model Hero {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  ctaText     String?
  ctaLink     String?
  bgMediaId   String?
  bgMedia     Media?   @relation("HeroBgMedia", fields: [bgMediaId], references: [id], onDelete: SetNull)
  logoMediaId String?
  logoMedia   Media?   @relation("HeroLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  isPrimary   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decorations HeroDecoration[]
}

model HeroDecoration {
  id            String   @id @default(cuid())
  heroId        String
  hero          Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media    @relation("HeroDecorationMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  positionX     String   @default("0px")
  positionY     String   @default("0px")
  zIndex        Int      @default(1)
  animationType String?  @default("float")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([heroId])
  @@index([mediaId])
}
